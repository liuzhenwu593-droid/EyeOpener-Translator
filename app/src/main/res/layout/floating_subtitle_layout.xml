<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="96dp"
    android:elevation="0dp"
    android:outlineProvider="none"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/floating_subtitle_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 顶部条:动作按钮(右) 和 翻译状态(左) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 翻译状态指示器："实时翻译中"文本 -->
            <LinearLayout
                android:id="@+id/translating_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <!-- "实时翻译中"文本 -->
                <TextView
                    android:id="@+id/translating_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/floating_translating"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:alpha="0.85" />
            </LinearLayout>

            <!-- 右侧动作按钮组(设置 / 展开 / 关闭) -->
            <LinearLayout
                android:id="@+id/top_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <!-- 设置 -->
                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:src="@drawable/ic_subtitle_settings"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/floating_btn_settings" />

                <!-- 展开 -->
                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:src="@drawable/ic_subtitle_back"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/floating_btn_back" />

                <!-- 关闭 -->
                <ImageView
                    android:id="@+id/btn_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:src="@drawable/ic_subtitle_close"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/floating_btn_cancel" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 字幕列表滚动区 -->
        <ScrollView
            android:id="@+id/subtitle_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:minHeight="48dp">

            <LinearLayout
                android:id="@+id/subtitle_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            </LinearLayout>
        </ScrollView>

        <!--
            错误提示条：翻译失败 / 模型未就绪等 runtimeError。
            之前在 MainActivity 只用前台 Toast 呈现，用户切在别的 App 上看悬浮字幕时
            完全看不到失败原因（表现为"只有原文没有译文"且无任何提示），故在此常驻显示。
        -->
        <TextView
            android:id="@+id/subtitle_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFB4A0"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 右下角缩放柄:根 FrameLayout 的直接子 view,浮于内容之上,48dp 触摸区 -->
    <View
        android:id="@+id/resize_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/resize_handle_bg"
        android:contentDescription="@null" />
</FrameLayout>
